+++ b/app/src/io/freemytv/KrasViewFeed.java
@@ -0,0 +1,34 @@
+package io.freemytv;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.Consumer;
+
+/** Only published title cards cross the app boundary; the session remains in KrasView TV. */
+final class KrasViewFeed {
+    static final Uri URI=Uri.parse("content://local.krasview.tv.recommendations/items");
+    static final String PACKAGE="local.krasview.tv";
+    final Context context;final Consumer<List<Recs.Pick>> listener;final Handler main=new Handler(Looper.getMainLooper());
+    final ExecutorService io=Executors.newSingleThreadExecutor();final AtomicBoolean reading=new AtomicBoolean();
+    boolean active,observing,dirty;long lastRead;
+    final ContentObserver observer=new ContentObserver(main){@Override public void onChange(boolean self){refresh(true);}};
+    KrasViewFeed(Context c,Consumer<List<Recs.Pick>> listener){context=c;this.listener=listener;}
+    void active(boolean value){if(active==value)return;active=value;if(value){try{context.getContentResolver().registerContentObserver(URI,true,observer);observing=true;}catch(RuntimeException ignored){}refresh(true);}else if(observing){context.getContentResolver().unregisterContentObserver(observer);observing=false;}}
+    void refresh(boolean force){if(!active||(!force&&SystemClock.uptimeMillis()-lastRead<15000))return;if(!reading.compareAndSet(false,true)){dirty|=force;return;}lastRead=SystemClock.uptimeMillis();
+        io.execute(()->{List<Recs.Pick> cards=new ArrayList<>();try(Cursor cursor=context.getContentResolver().query(URI,new String[]{"_id","address","title","image","year","section"},null,null,null)){
+            if(cursor!=null)while(cursor.moveToNext()&&cards.size()<36){String address=cursor.getString(1),title=cursor.getString(2),image=cursor.getString(3),year=cursor.getString(4),section=cursor.getString(5);
+                if(address==null||!address.matches("[\\p{L}\\p{N}_.-]{1,256}")||title==null||title.isEmpty()||!Arrays.asList("movie","series","anime").contains(section))continue;
+                Uri art=Uri.parse(image==null?"":image);if(!"https".equals(art.getScheme())||!("cdn1.atoto.ru".equals(art.getHost())||"image.krasview.ru".equals(art.getHost())))continue;
+                Recs.Pick p=new Recs.Pick();p.id=cursor.getInt(0);p.kind="movie".equals(section)?"movie":"tv";p.title=title;p.backdrop=image;p.app="krasview";p.pkg=PACKAGE;p.link="krasviewtv://film/"+Uri.encode(address);p.meta=year==null?"":year;p.krasview=true;p.detailed=true;cards.add(p);
+            }
+        }catch(RuntimeException ignored){}final List<Recs.Pick> result=cards;main.post(()->{reading.set(false);listener.accept(result);if(dirty){dirty=false;refresh(true);}});});
+    }
+}
